<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GalPipeline.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GalPipeline.UI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        数据模板刻意使用经典 {Binding} + INPC（条目 VM），而非 x:Bind：
        WinAppSDK 2.x 的 XamlCompiler 在 dotnet CLI + 非英文区域下对
        DataTemplate 内 x:Bind 存在内部崩溃（WMC9999 掩码），页面级
        x:Bind 不受影响。规避决策记录于此。
    -->
    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部：状态与导入区 ==================== -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                             Fill="{x:Bind Vm.StatusBrush, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Vm.StatusMessage, Mode=OneWay}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="440"
                             PlaceholderText="拖入或输入 .ks 剧本文件路径"
                             Text="{x:Bind Vm.CurrentFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="浏览…" Click="OnBrowseClick" />
                    <Button Content="载入剧本"
                            Command="{x:Bind Vm.LoadFileCommand}"
                            CommandParameter="{x:Bind Vm.CurrentFilePath, Mode=OneWay}" />
                    <Border CornerRadius="4" Padding="8,4" VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind Vm.EngineBadgeVisibility, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Vm.DetectedEngineName, Mode=OneWay}" FontSize="12" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <Expander Grid.Column="1" Header="API 配置" Width="380"
                      HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel Spacing="8" Margin="0,4,0,0">
                    <TextBox Header="API Base"
                             Text="{x:Bind Vm.ApiConfig.ApiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox Header="API Key"
                                 Password="{x:Bind Vm.ApiConfig.ApiKey, Mode=TwoWay}" />
                    <TextBox Header="模型"
                             Text="{x:Bind Vm.ApiConfig.ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Expander>
        </Grid>

        <!-- ==================== 中部：双栏对照工作台 ==================== -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Units, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Id}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ==================== 底部：操作控制台 ==================== -->
        <StackPanel Grid.Row="2" Spacing="10">
            <ProgressBar Value="{x:Bind Vm.ProgressPercent, Mode=OneWay}"
                         Maximum="100" Height="6" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Text="{x:Bind Vm.ProgressLabel, Mode=OneWay}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBox Header="导出目录" Width="220"
                             Text="{x:Bind Vm.ExportDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="开始批量翻译"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}"
                            Command="{x:Bind Vm.TranslateBatchCommand}" />
                    <Button Content="一键导出回写"
                            IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}"
                            Command="{x:Bind Vm.ExportAssetCommand}"
                            CommandParameter="{x:Bind Vm.ExportDirectory, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
