<UserControl
    x:Class="GalPipeline.Desktop.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        设置卡片组（lepoco/wpfui v4 真实控件面：CardControl / CardExpander，
        包内不存在 WinUI 生态的 SettingsCard —— 决策依据包内 Wpf.Ui.xml 文档）。
        CardControl 无 Description 属性：副标题内嵌于 Header 的 StackPanel。
        WPF StackPanel 无 Spacing：以卡片 Margin 表达组间距。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24" MaxWidth="920" HorizontalAlignment="Left">

            <ui:TextBlock
                FontTypography="TitleLarge"
                Text="模型与后端设置"
                Margin="0,0,0,4" />
            <ui:TextBlock
                FontTypography="Body"
                TextWrapping="Wrap"
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="配置 OpenAI 兼容端点、推理力度与采样温度；模型清单经 Python Sidecar 的 fetch_models 跨进程拉取。" />

            <!-- 端点与凭据 -->
            <ui:CardControl Margin="0,0,0,2" Icon="{ui:SymbolIcon Symbol=Globe24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="API Base URL" />
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="OpenAI 兼容端点根地址（推理调度与模型拉取共用）" />
                    </StackPanel>
                </ui:CardControl.Header>
                <TextBox
                    Width="360"
                    Text="{Binding ApiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,16" Icon="{ui:SymbolIcon Symbol=Key24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="API Key" />
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="留空表示匿名访问（本地环回 Mock 常用）" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:PasswordBox
                    Width="360"
                    Password="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </ui:CardControl>

            <!-- 推理与采样 -->
            <ui:CardControl Margin="0,0,0,2" Icon="{ui:SymbolIcon Symbol=BrainCircuit24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Reasoning Effort" />
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="推理力度：适配 DeepSeek-R1 / OpenAI o 系列 / GLM 推理模型" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox
                    Width="180"
                    ItemsSource="{Binding ReasoningEffortOptions}"
                    SelectedItem="{Binding SelectedReasoningEffort}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,16" Icon="{ui:SymbolIcon Symbol=TopSpeed24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Temperature" />
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding TemperatureDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider
                        Width="280"
                        VerticalAlignment="Center"
                        Minimum="0"
                        Maximum="2"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="True"
                        Value="{Binding Temperature}" />
                    <TextBlock
                        Width="48"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding Temperature, StringFormat={}{0:0.00}}" />
                </StackPanel>
            </ui:CardControl>

            <!-- 模型清单：CardExpander 展开后操作 -->
            <ui:CardExpander Icon="{ui:SymbolIcon Symbol=DataUsage24}">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="模型清单" />
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="{Binding ModelRefreshStatus}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,12,0,4">
                    <ComboBox
                        Width="360"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Models}"
                        SelectedItem="{Binding SelectedModel}" />
                    <ui:Button
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        Appearance="Primary"
                        Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                        Content="刷新模型列表"
                        Command="{Binding RefreshModelsCommand}" />
                    <ui:TextBlock
                        Margin="0,8,0,0"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="刷新经 Python Sidecar 的 fetch_models 方法发起 GET {base}/models；本地环回演练可复用 tests/fixtures/mock_llm_server.py。" />
                </StackPanel>
            </ui:CardExpander>

            <!-- 外部工具链环境：四级瀑布流探测状态的集中呈现与自定义路径管理 -->
            <ui:CardExpander Margin="0,16,0,0" Icon="{ui:SymbolIcon Symbol=Wrench24}">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="外部工具链环境 (Toolchain Environment)" />
                        <ui:TextBlock
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="{Binding ToolchainSummary}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,12,0,4">
                    <ui:Button
                        HorizontalAlignment="Left"
                        Appearance="Secondary"
                        Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                        Content="重新探测全部工具"
                        Command="{Binding ReprobeAllCommand}"
                        ToolTip="重跑四级瀑布流（自定义路径 → 本地 tools/ → PATH），刷新全部状态徽章" />
                    <ItemsControl
                        Margin="0,12,0,0"
                        ItemsSource="{Binding ToolItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12,10"
                                    CornerRadius="6"
                                    Background="#1C1C1C"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 行 1：名称 + 徽章 + 来源 + 版本 -->
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#E8E8E8" />
                                            <Border
                                                Margin="8,0,0,0"
                                                Padding="8,2"
                                                CornerRadius="8"
                                                Background="#262626">
                                                <TextBlock
                                                    Text="{Binding StatusKindText}"
                                                    FontSize="11"
                                                    Foreground="{Binding StatusBrush}" />
                                            </Border>
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                Text="{Binding VersionText, StringFormat=v{0}}"
                                                FontSize="11"
                                                Foreground="#9CA3AF" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                Text="{Binding OriginLabel}"
                                                FontSize="11"
                                                Foreground="#6E7681"
                                                ToolTip="命中来源：Custom=自定义路径 / Local=本地 tools/ / PATH=环境变量" />
                                        </StackPanel>

                                        <!-- 行 1 右侧：动作组 -->
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Orientation="Horizontal">
                                            <ui:Button
                                                MinWidth="0"
                                                Padding="8,3"
                                                FontSize="11"
                                                Appearance="Secondary"
                                                Content="浏览/配置路径"
                                                Command="{Binding BrowseCommand}"
                                                ToolTip="选择可执行文件作为该工具的自定义路径（最高探测优先级）" />
                                            <ui:Button
                                                Margin="6,0,0,0"
                                                MinWidth="0"
                                                Padding="8,3"
                                                FontSize="11"
                                                Appearance="Secondary"
                                                Content="恢复默认"
                                                IsEnabled="{Binding HasCustomPath}"
                                                Command="{Binding ResetCommand}"
                                                ToolTip="清除自定义路径，回退 本地 tools/ → PATH 的自动瀑布探测" />
                                            <ui:Button
                                                Margin="6,0,0,0"
                                                MinWidth="0"
                                                Padding="8,3"
                                                FontSize="11"
                                                Appearance="Secondary"
                                                Content="打开目录"
                                                IsEnabled="{Binding IsReady}"
                                                Command="{Binding OpenDirectoryCommand}"
                                                ToolTip="在资源管理器中定位当前生效的可执行文件" />
                                        </StackPanel>

                                        <!-- 行 2：用途描述 -->
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,4,0,0"
                                            Text="{Binding PurposeText}"
                                            FontSize="11"
                                            TextWrapping="Wrap"
                                            Foreground="#8A8F98" />

                                        <!-- 行 3：生效路径 -->
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Margin="0,4,0,0"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding ResolvedPath}"
                                            Foreground="#77808C"
                                            Text="{Binding ResolvedPath}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:TextBlock
                        Margin="0,4,0,0"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="探测优先级：自定义路径 → 程序目录 tools/{tool}/ → 系统 PATH。改完路径即刻生效（转码/解包/TLG 转换在下一次调用时消费最新状态）。" />
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
