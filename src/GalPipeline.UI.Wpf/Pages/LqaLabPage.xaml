<Page
    x:Class="GalPipeline.Desktop.Pages.LqaLabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- LQA Lab 质检中心：质量门禁看板 + 违规治理工作台（占位 InfoBar 已废除） -->
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 头部：标题 + 统计 + 手动刷新 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <ui:TextBlock FontTypography="TitleLarge" Text="LQA Lab 质检中心" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding FailedUnits, StringFormat=待治理 {0} 行}" />
                    <TextBlock
                        Margin="14,0,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding TotalUnits, StringFormat=/ 共 {0} 行}" />
                </StackPanel>
            </StackPanel>
            <ui:Button
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Appearance="Secondary"
                Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                Content="刷新看板"
                Command="{Binding RefreshBoardCommand}"
                ToolTip="从剧本工坊当前数据重建看板" />
        </Grid>

        <!-- 规则聚合徽章（按 error 数降序；每条徽章 = 规则名 × 条数） -->
        <ItemsControl
            Grid.Row="1"
            ItemsSource="{Binding RuleSummaries}"
            Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,8,0"
                        Padding="10,4"
                        CornerRadius="10"
                        Background="#3A3A3C">
                        <TextBlock
                            FontSize="11"
                            Foreground="#FFFFFF"
                            Text="{Binding Total, StringFormat={}{0} 项待治理}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 主体：违规列表 / 全绿态 / 未载入态 -->
        <Grid Grid.Row="2">
            <!-- 违规治理列表 -->
            <ListView
                ItemsSource="{Binding Violations}"
                Visibility="{Binding ViolationsVisibility}"
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                BorderThickness="1"
                BorderBrush="#252525">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 定位列：行号 + 级别徽章 + 角色 -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0" MinWidth="110">
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="#7FB2E5"
                                        Text="{Binding LineTag}" />
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="#F2A4AD"
                                        Text="{Binding SeverityBadge}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Speaker}" />
                                </StackPanel>

                                <!-- 明细列：规则 + 描述 + 原译对比 -->
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#E5E7EB"
                                        Text="{Binding RuleLabel}" />
                                    <TextBlock
                                        FontSize="11"
                                        TextWrapping="Wrap"
                                        Foreground="#F2A4AD"
                                        Text="{Binding Summary}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        TextWrapping="Wrap"
                                        Foreground="#9AA3AE"
                                        Text="{Binding SourceText, StringFormat=原文：{0}}" />
                                    <TextBlock
                                        FontSize="11"
                                        TextWrapping="Wrap"
                                        Foreground="#D7DCE4"
                                        Text="{Binding TranslatedText, StringFormat=译文：{0}}" />
                                </StackPanel>

                                <!-- 治理列：定位工坊 / 单条定向重译 -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <ui:Button
                                        Margin="0,0,0,6"
                                        MinWidth="110"
                                        Appearance="Secondary"
                                        Icon="{ui:SymbolIcon Symbol=ArrowRight24}"
                                        Content="定位到工坊"
                                        Command="{Binding DataContext.FocusViolationCommand,
                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="在剧本工坊中选中该行" />
                                    <ui:Button
                                        MinWidth="110"
                                        Appearance="Primary"
                                        Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                        Content="定向重译"
                                        Command="{Binding DataContext.RetryViolationCommand,
                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="重翻该行并自动复检 LQA" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 全绿态：当前剧本无任何违例留痕 -->
            <StackPanel
                Visibility="{Binding AllGreenVisibility}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <ui:SymbolIcon
                    Symbol="CheckmarkCircle24"
                    FontSize="42"
                    Foreground="#4ADE80"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="14"
                    HorizontalAlignment="Center"
                    Text="当前剧本全部通过质检" />
            </StackPanel>

            <!-- 未载入态：工坊还没有数据 -->
            <StackPanel
                Visibility="{Binding EmptyWorkspaceVisibility}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <ui:SymbolIcon
                    Symbol="Info24"
                    FontSize="42"
                    Foreground="#77808C"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="14"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="尚未载入剧本 —— 请先在剧本工坊打开文件或拖入游戏目录" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
