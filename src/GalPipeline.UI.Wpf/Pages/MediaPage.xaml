<Page
    x:Class="GalPipeline.Desktop.Pages.MediaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:GalPipeline.Desktop.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Media">

    <!--
        Media 视觉修图工作台（Fluent 2 / WPF-UI 4.3）。

        布局契约：
          · 顶栏：工作目标题 + 当前目录 + 资产计数徽章 + 目录动作（选择/重新扫描）；
          · 左栏：检索框 + 状态筛选 + **虚拟化卡片墙**（ui:Card + ui:CardAction + ui:Badge 角标）；
          · 中栏：工具栏（ui:Button / ui:DropDownButton / Fluent Slider）+ 棋盘画布
                  （单图缩放 / 滑动帘对比 / 分屏对比）；
          · 页面级 ui:SnackbarPresenter：外部保存热重载的微交互提示（杜绝弹窗）。

        视图层只做两件非业务的事：滑动帘裁剪矩形（纯几何）与 Snackbar 呈现（宿主事务）。
        其余全部绑定 MediaViewModel。
    -->
    <Page.Resources>
        <conv:MediaStatusToAppearanceConverter x:Key="StatusToBadgeAppearance" />
        <conv:InverseBooleanConverter x:Key="InverseBoolean" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 透明通道棋盘底：16px 双色暗格（#171717 / #1F1F1F），只做「透明」标识不抢画面 -->
        <DrawingBrush
            x:Key="CheckerboardBrush"
            Stretch="None"
            TileMode="Tile"
            Viewport="0,0,16,16"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF141414">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF1E1E1E">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ···························· 顶栏 ···························· -->
        <Border
            Grid.Row="0"
            Padding="24,18,24,14"
            BorderBrush="#222222"
            BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="TitleLarge" Text="Media 视觉修图工作台" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <ui:TextBlock
                            MaxWidth="620"
                            VerticalAlignment="Center"
                            FontTypography="Body"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding FolderLabel}"
                            TextTrimming="CharacterEllipsis" />
                        <ui:Badge
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Appearance="Secondary"
                            Content="{Binding AssetCountLabel}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding OpenFolderCommand}"
                        Content="选择资产目录"
                        Icon="{ui:SymbolIcon Symbol=FolderOpen24}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}"
                        Content="重新扫描"
                        Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ···························· 主体 ···························· -->
        <Grid Grid.Row="1" Margin="24,16,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="384" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：虚拟化资产墙（ui:Card + CardAction + Badge） -->
            <ui:Card Grid.Column="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="12,12,12,8">
                        <ui:TextBox
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            ClearButtonEnabled="True"
                            PlaceholderText="检索文件名 / 状态 / 分辨率"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <ui:DropDownButton
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Content="{Binding StatusFilterLabel}">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu>
                                    <MenuItem
                                        Command="{Binding SetStatusFilterCommand}"
                                        CommandParameter="All"
                                        Header="全部状态" />
                                    <MenuItem
                                        Command="{Binding SetStatusFilterCommand}"
                                        CommandParameter="Untouched"
                                        Header="未修改" />
                                    <MenuItem
                                        Command="{Binding SetStatusFilterCommand}"
                                        CommandParameter="Editing"
                                        Header="修图中" />
                                    <MenuItem
                                        Command="{Binding SetStatusFilterCommand}"
                                        CommandParameter="Completed"
                                        Header="已完成" />
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                    </StackPanel>

                    <!-- 虚拟化卡片墙：回收模式 + 像素滚动，万级资产列表也不卡顿 -->
                    <ListView
                        Grid.Row="1"
                        x:Name="AssetWall"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding AssetsView}"
                        SelectedItem="{Binding SelectedAsset}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ListViewItem}}" TargetType="ListViewItem">
                                <Setter Property="Margin" Value="12,0,12,10" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Width="72"
                                                Height="72"
                                                Background="#101010"
                                                ClipToBounds="True"
                                                CornerRadius="4">
                                                <Grid>
                                                    <ui:Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                    <ui:TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="无法解码"
                                                        Visibility="{Binding ThumbnailFailed, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <ui:TextBlock
                                                    FontTypography="BodyStrong"
                                                    Text="{Binding FileName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <ui:TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding MetaLabel}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                    <ui:Badge
                                                        Appearance="{Binding Status, Converter={StaticResource StatusToBadgeAppearance}}"
                                                        Background="{Binding StatusBrush}"
                                                        Content="{Binding StatusLabel}"
                                                        Foreground="{Binding StatusForeground}" />
                                                    <ui:TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding PixelSizeLabel}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Border
                                            Grid.Row="1"
                                            BorderBrush="#242424"
                                            BorderThickness="0,1,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:CardAction
                                                    Command="{Binding DataContext.MarkCompletedCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                    CommandParameter="{Binding}"
                                                    Content="标记已完成"
                                                    Icon="{ui:SymbolIcon Symbol=Checkmark24}"
                                                    IsChevronVisible="False" />
                                                <ui:CardAction
                                                    Command="{Binding DataContext.MarkEditingCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                    CommandParameter="{Binding}"
                                                    Content="标记修图中"
                                                    Icon="{ui:SymbolIcon Symbol=Edit24}"
                                                    IsChevronVisible="False" />
                                                <ui:CardAction
                                                    Command="{Binding DataContext.RevealAssetCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                    CommandParameter="{Binding}"
                                                    Content="定位"
                                                    Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                                    IsChevronVisible="False" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 检索空态：给出可操作的引导（清除筛选），不使用静态提示条 -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="12,8,12,12"
                        Visibility="{Binding IsFilterEmpty, Converter={StaticResource BoolToVisibility}}">
                        <ui:TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="当前检索 / 筛选没有匹配的资产。" />
                        <ui:Button
                            Margin="0,8,0,0"
                            Command="{Binding SetStatusFilterCommand}"
                            CommandParameter="All"
                            Content="清除状态筛选" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- 中栏：画布工作台（工具栏 + 棋盘画布 + 对比模式） -->
            <ui:Card Grid.Column="2" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <Border
                        Grid.Row="0"
                        Padding="12,10"
                        BorderBrush="#242424"
                        BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <ui:ToggleSwitch
                                VerticalAlignment="Center"
                                Content="透明棋盘"
                                IsChecked="{Binding IsCheckerboardVisible}" />

                            <ui:DropDownButton
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Content="{Binding CompareModeLabel}">
                                <ui:DropDownButton.Flyout>
                                    <ContextMenu>
                                        <MenuItem
                                            Command="{Binding SetCompareModeCommand}"
                                            CommandParameter="None"
                                            Header="关闭对比" />
                                        <MenuItem
                                            Command="{Binding SetCompareModeCommand}"
                                            CommandParameter="Curtain"
                                            Header="滑动帘对比" />
                                        <MenuItem
                                            Command="{Binding SetCompareModeCommand}"
                                            CommandParameter="Split"
                                            Header="分屏对比" />
                                    </ContextMenu>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>

                            <StackPanel
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsCurtainMode, Converter={StaticResource BoolToVisibility}}">
                                <ui:TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="帘幕位置" />
                                <Slider
                                    Width="140"
                                    VerticalAlignment="Center"
                                    Maximum="98"
                                    Minimum="2"
                                    Value="{Binding CompareSplitPercent}" />
                            </StackPanel>

                            <ui:Button
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding ResetBaselineCommand}"
                                Content="重置基线"
                                Icon="{ui:SymbolIcon Symbol=ArrowReset24}"
                                IsEnabled="{Binding HasBaseline}"
                                ToolTip="把当前磁盘内容重新抓取为「原图快照」" />
                            <ui:Button
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding ReloadSelectedCommand}"
                                Content="重新载入"
                                Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                IsEnabled="{Binding HasImage}" />

                            <StackPanel
                                Margin="18,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ui:Button
                                    VerticalAlignment="Center"
                                    Command="{Binding ZoomOutCommand}"
                                    Icon="{ui:SymbolIcon Symbol=ZoomOut24}" />
                                <Slider
                                    Width="150"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Maximum="800"
                                    Minimum="10"
                                    SmallChange="10"
                                    TickFrequency="10"
                                    Value="{Binding ZoomPercent}" />
                                <ui:Button
                                    VerticalAlignment="Center"
                                    Command="{Binding ZoomInCommand}"
                                    Icon="{ui:SymbolIcon Symbol=ZoomIn24}" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ResetZoomCommand}"
                                    Content="{Binding ZoomLabel}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 画布 -->
                    <Grid Grid.Row="1" Margin="12,12,12,12" ClipToBounds="True">
                        <Border Background="#0D0D0D" CornerRadius="6" />
                        <Border
                            Background="{StaticResource CheckerboardBrush}"
                            CornerRadius="6"
                            Visibility="{Binding IsCheckerboardVisible, Converter={StaticResource BoolToVisibility}}" />

                        <!-- 空态引导（可操作，非静态提示条） -->
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasImage, Converter={StaticResource InverseBoolean}}">
                            <ui:SymbolIcon
                                HorizontalAlignment="Center"
                                FontSize="34"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="ImageEdit24" />
                            <ui:TextBlock
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                FontTypography="Body"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="从左侧资产墙选择一张图片开始修图" />
                        </StackPanel>

                        <!-- 单图模式：滚动 + 缩放（LayoutTransform 保清晰度） -->
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding IsSingleMode, Converter={StaticResource BoolToVisibility}}">
                            <Image
                                MaxHeight="640"
                                Margin="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="Fant"
                                Source="{Binding CurrentImage}"
                                Stretch="Uniform">
                                <Image.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
                                </Image.LayoutTransform>
                            </Image>
                        </ScrollViewer>

                        <!-- 滑动帘：底层=磁盘最新，上层=原图快照（按比例裁剪） -->
                        <Grid
                            x:Name="CurtainHost"
                            Margin="16"
                            ClipToBounds="True"
                            SizeChanged="OnCurtainHostSizeChanged"
                            Visibility="{Binding IsCurtainMode, Converter={StaticResource BoolToVisibility}}">
                            <Image
                                RenderOptions.BitmapScalingMode="Fant"
                                Source="{Binding CurrentImage}"
                                Stretch="Uniform" />
                            <Image
                                x:Name="CurtainBaselineLayer"
                                RenderOptions.BitmapScalingMode="Fant"
                                Source="{Binding BaselineImageForView}"
                                Stretch="Uniform">
                                <Image.Clip>
                                    <RectangleGeometry x:Name="CurtainClip" Rect="0,0,0,0" />
                                </Image.Clip>
                            </Image>

                            <Canvas x:Name="CurtainOverlay">
                                <Line
                                    x:Name="CurtainLine"
                                    Stroke="#4A9EFF"
                                    StrokeThickness="1.5"
                                    X1="0"
                                    X2="0"
                                    Y1="0"
                                    Y2="0" />
                                <Thumb
                                    x:Name="CurtainThumb"
                                    Width="26"
                                    Height="44"
                                    Cursor="SizeWE"
                                    DragDelta="OnCurtainThumbDragDelta" />
                            </Canvas>

                            <ui:Badge
                                Margin="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Appearance="Secondary"
                                Content="原图快照" />
                            <ui:Badge
                                Margin="10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Appearance="Info"
                                Content="磁盘最新" />
                        </Grid>

                        <!-- 分屏：左右各半等比铺满 -->
                        <Grid
                            Margin="16"
                            Visibility="{Binding IsSplitMode, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Image
                                    Margin="8"
                                    RenderOptions.BitmapScalingMode="Fant"
                                    Source="{Binding BaselineImageForView}"
                                    Stretch="Uniform" />
                                <ui:Badge
                                    Margin="10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Appearance="Secondary"
                                    Content="原图快照" />
                            </Grid>

                            <Border Grid.Column="1" Background="#2A2A2A" />

                            <Grid Grid.Column="2">
                                <Image
                                    Margin="8"
                                    RenderOptions.BitmapScalingMode="Fant"
                                    Source="{Binding CurrentImage}"
                                    Stretch="Uniform" />
                                <ui:Badge
                                    Margin="10"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Appearance="Info"
                                    Content="磁盘最新" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 画布状态条 -->
                    <Border
                        Grid.Row="2"
                        Padding="14,8"
                        BorderBrush="#242424"
                        BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding CurrentAssetLabel}"
                                TextTrimming="CharacterEllipsis" />
                            <ui:TextBlock
                                Margin="12,0,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding BaselineHint}" />
                            <ui:TextBlock
                                Margin="12,0,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding HotReloadCount, StringFormat=热重载 {0} 次}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- ···························· 底栏：格式与热重载口径 ···························· -->
        <Border
            Grid.Row="2"
            Padding="24,8"
            BorderBrush="#222222"
            BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="Info24" />
                <ui:TextBlock
                    Margin="6,0,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding SupportedFormatsLabel, StringFormat=受支持格式：{0}}" />
                <ui:TextBlock
                    Margin="12,0,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="· 外部修图软件覆盖保存后自动热重载（本地文件监视，零出网）" />
            </StackPanel>
        </Border>

        <!-- 微交互宿主：热重载 / 状态变更 / 失败提示全部走 Snackbar -->
        <ui:SnackbarPresenter
            x:Name="MediaSnackbarPresenter"
            Grid.RowSpan="3"
            Margin="0,0,24,24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom" />
    </Grid>
</Page>
