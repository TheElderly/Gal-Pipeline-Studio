<Page
    x:Class="GalPipeline.Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- WPF StackPanel 无 Spacing 属性，以子元素 Margin 表达间距 -->
    <StackPanel Margin="28,24">
        <ui:TextBlock FontTypography="TitleLarge" Text="Settings 模型与后端设置"
                      Margin="0,0,0,12" />
        <ui:TextBlock FontTypography="Body"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      TextWrapping="Wrap"
                      Margin="0,0,0,12"
                      Text="API Base / Key / 模型选择（fetch_models 拉取）与 reasoning_effort 分段控件。" />
        <ui:InfoBar
            Title="占位导航槽"
            Message="设置卡片将于后续切片交付。"
            IsOpen="True"
            IsClosable="False" />
    </StackPanel>
</Page>
