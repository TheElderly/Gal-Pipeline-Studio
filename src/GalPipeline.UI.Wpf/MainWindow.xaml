<ui:FluentWindow
    x:Class="GalPipeline.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Gal-Pipeline Studio"
    Width="1280"
    Height="800"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True">

    <!--
        NavigationView 骨架（lepoco/wpfui）：侧栏四主导航槽 +
        底部全局状态栏。页内容以 WPF Frame 承载（与侧栏并列的
        经典导航原语），不依赖 WPF-UI 的 IPageService 组装面。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="Gal-Pipeline Studio"
            Padding="8,4" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:NavigationView
                Grid.Column="0"
                x:Name="RootNavigation"
                PaneDisplayMode="Left"
                OpenPaneLength="230"
                IsBackButtonVisible="Collapsed"
                PreviewMouseLeftButtonUp="OnPaneMouseUp">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem
                        Tag="studio"
                        Content="Studio 剧本工坊"
                        Icon="{ui:SymbolIcon Symbol=Edit24}" />
                    <ui:NavigationViewItem
                        Tag="assets"
                        Content="Asset Hub 资产归档"
                        Icon="{ui:SymbolIcon Symbol=Archive24}" />
                    <ui:NavigationViewItem
                        Tag="lqa"
                        Content="LQA Lab 质检中心"
                        Icon="{ui:SymbolIcon Symbol=ShieldCheckmark24}" />
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem
                        Tag="settings"
                        Content="Settings 模型与后端设置"
                        Icon="{ui:SymbolIcon Symbol=Settings24}" />
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <Frame
                Grid.Column="1"
                x:Name="ContentFrame"
                NavigationUIVisibility="Hidden" />
        </Grid>

        <!-- 底部全局状态栏：Sidecar 状态 / 当前页 / Token 消耗 -->
        <Border
            Grid.Row="2"
            Padding="16,8"
            BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             Fill="{Binding SidecarStatusBrush}" />
                    <TextBlock Text="{Binding SidecarStatusText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{Binding CurrentPageTitle}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding TokenUsageText}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
